{
  "sourceLanguage": "en",
  "strings": {
    "%@ · %@ s": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ 秒"
          }
        }
      }
    },
    "%lld sources": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个片源"
          }
        }
      }
    },
    "%lld sources did not respond.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个接口未能返回结果。"
          }
        }
      }
    },
    "A secure connection could not be established. Check the stream address or switch sources.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法建立安全连接。请检查播放地址或切换片源。"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add a compatible subscription in Sources.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「片源」中添加兼容的订阅。"
          }
        }
      }
    },
    "Add a searchable source in Sources.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「片源」中添加可搜索的点播源。"
          }
        }
      }
    },
    "Add an M3U or TXT playlist in Sources.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「片源」中添加 M3U 或 TXT 播放列表。"
          }
        }
      }
    },
    "Add source": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加片源"
          }
        }
      }
    },
